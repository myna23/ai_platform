# Zambia Geospatial Intelligence Assistant — local configuration
#
# NO CREDENTIALS ARE REQUIRED OR SUPPORTED.
# AI access uses the Posit Connect OAuth 2.0 token exchange (RFC 8693); the
# platform issues a short-lived token per session and nothing is stored.
# Zambia GeoHub public datasets are read anonymously.

# Set to "true" when running on WBG Posit Connect.
WB_POSIT=true

# Optional tuning
MAX_FEATURES=200
HUB_BASE_URL=https://zmb-geowb.hub.arcgis.com
